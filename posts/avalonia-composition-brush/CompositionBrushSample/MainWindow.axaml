<Window
    x:Class="CompositionBrushSample.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:CompositionBrushSample.Pages"
    Title="CompositionBrushSample"
    Width="920"
    Height="620"
    MinWidth="720"
    MinHeight="520"
    d:DesignHeight="620"
    d:DesignWidth="920"
    mc:Ignorable="d">
    <TabbedPage>
        <pages:BasicPage Header="Basic" />
        <pages:GlowPage Header="Glow" />
        <pages:SkeletonPage Header="Skeleton" />
    </TabbedPage>
</Window>
